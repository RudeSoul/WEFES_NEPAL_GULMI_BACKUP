#!/usr/bin/env bash
# .githooks/pre-commit
# Enforces:
# 1. Branch Protection (no direct commits to main/master)
# 2. 6-Tier Data Integrity & Governance Gatekeeper
# 3. Check Binary File Size Limit (Max 40 MB per file to prevent committing raw rasters)

# 0. Branch Protection (Never commit directly to main or master)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
    echo "=================================================================="
    echo " ❌ COMMIT REJECTED: Direct commits to '$CURRENT_BRANCH' are forbidden!"
    echo " Work on a feature branch instead: git checkout -b feat/your-feature"
    echo "=================================================================="
    exit 1
fi

# 1. Verify 6-Tier Data Integrity & Governance Gatekeeper
if [ -f "scripts/verify_data_integrity.py" ]; then
    echo "--> [Pre-Commit] Verifying 6-tier data integrity & platform rules..."
    python3 scripts/verify_data_integrity.py || exit 1
fi

# 2. Check Binary File Size Limit (Max 40 MB per file)
MAX_FILE_BYTES=$((40 * 1024 * 1024))
while IFS= read -r file; do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file" | tr -d ' ')
        if [ "$FILE_SIZE" -gt "$MAX_FILE_BYTES" ]; then
            FILE_MB=$((FILE_SIZE / 1024 / 1024))
            echo ""
            echo "=================================================================="
            echo " ❌ COMMIT REJECTED: File size exceeds 40 MB limit!"
            echo "=================================================================="
            echo " '$file' is ${FILE_MB} MB (maximum allowed is 40 MB)."
            echo " Track large binary rasters in 'data/manifest.json' instead."
            echo "=================================================================="
            echo ""
            exit 1
        fi
    fi
done < <(git diff --cached --name-only)

exit 0
