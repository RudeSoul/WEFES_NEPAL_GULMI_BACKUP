{
  "$schema": "https://unpkg.com/knip@5/overview/knip.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/update-coffee-data.js"]
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared-types": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/database": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "engines/nexus": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
