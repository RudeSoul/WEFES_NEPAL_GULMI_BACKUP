{
  "name": "wefes-nexus-nepal-root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm sync:data && pnpm exec turbo run build",
    "dev": "pnpm sync:data && pnpm exec turbo run dev --parallel",
    "sync:data": "python3 scripts/sync_web_assets.py",
    "test": "pnpm check:data && pnpm exec turbo run test",
    "check:data": "python3 scripts/verify_data_integrity.py",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "pnpm exec turbo run lint",
    "lint:fix": "pnpm exec turbo run lint:fix",
    "knip": "knip",
    "knip:report": "knip --reporter compact --no-exit-code",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm exec turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "knip": "^6.32.2",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  },
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
